# Postgres / pgvector (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://bookrag:bookrag@localhost:5432/bookrag

# Embedding model (sentence-transformers, runs locally, no key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Answer-generation provider for api/main.py - "anthropic" (default, hosted Claude,
# best quality) or "ollama" (local, free, no API key - see README Setup).
LLM_PROVIDER=anthropic
CLAUDE_MODEL=claude-opus-5

# Claude API key - required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Ollama settings - only used when LLM_PROVIDER=ollama. Requires `ollama serve`
# running locally and the model pulled (`ollama pull llama3.2`).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Google Books API key is optional for basic search; set it if you hit rate limits
GOOGLE_BOOKS_API_KEY=
